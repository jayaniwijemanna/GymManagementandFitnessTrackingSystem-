<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_action_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_orange">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_package"
                android:tint="@color/white"
                android:contentDescription="Package"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_package_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Package Name"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_package_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$0 / Month"
                android:textColor="@color/accent_green"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_edit_package"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Edit"
            android:src="@drawable/ic_edit"
            android:tint="@color/primary"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/btn_delete_package"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete"
            android:tint="@color/accent_red"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_package_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Package description goes here"
        android:textColor="@color/text_gray"
        android:textSize="12sp"/>

</LinearLayout>

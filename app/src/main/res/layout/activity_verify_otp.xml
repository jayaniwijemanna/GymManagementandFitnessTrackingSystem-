<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main"
    tools:context=".VerifyOtpActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Logo Container -->
        <FrameLayout
            android:id="@+id/logo_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/title_titan_gym"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Titan Gym Logo"
                android:src="@drawable/ic_dumbbell" />
        </FrameLayout>

        <!-- Main Title -->
        <TextView
            android:id="@+id/title_titan_gym"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="TITAN GYM"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo_container"
            app:layout_constraintBottom_toTopOf="@id/badge_secure" />

        <!-- Badge -->
        <LinearLayout
            android:id="@+id/badge_secure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_titan_gym"
            app:layout_constraintBottom_toTopOf="@id/otp_card">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Secure Icon"
                android:src="@drawable/ic_shield"
                app:tint="@color/accent_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="SECURITY CHECK"
                android:textColor="@color/badge_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card Container -->
        <LinearLayout
            android:id="@+id/otp_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/badge_secure"
            app:layout_constraintBottom_toTopOf="@id/footer_copyright">

            <!-- Card Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Verify Email Address"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_otp_instructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="We sent a security OTP to your email. Enter the 4-digit code below."
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <!-- Input: OTP Box -->
            <LinearLayout
                android:layout_width="180dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_input_selector"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:hint="••••"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_hint"
                    android:textSize="24sp"
                    android:letterSpacing="0.4"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:text="Demo code is: 1234"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="italic" />

            <!-- Button: Verify -->
            <LinearLayout
                android:id="@+id/btn_verify"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Verify &amp; Create Profile"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Verify check"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Cancel Link -->
            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.05"
                android:text="Cancel &amp; Go Back"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Copyright Footer -->
        <TextView
            android:id="@+id/footer_copyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="© 2026 TITAN GYM SYSTEMS INC. ALL RIGHTS RESERVED."
            android:textColor="@color/text_gray"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otp_card" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle/Drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_input_default"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Member"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Full Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_member_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="John Doe"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Email -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email Address"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_member_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="john@example.com"
        android:inputType="textEmailAddress"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Phone -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_member_phone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="+1 234 567 8900"
        android:inputType="phone"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_member_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Membership Package -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Membership Package"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Package selection chips container -->
    <LinearLayout
        android:id="@+id/package_chips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="4dp">

        <!-- "No Package" option (always shown) -->
        <LinearLayout
            android:id="@+id/chip_no_package"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No Package"
                android:textColor="@color/text_hint"
                android:textSize="14sp"/>

            <ImageView
                android:id="@+id/check_no_package"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                android:tint="@color/primary"
                android:visibility="gone"
                android:contentDescription="Selected"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_no_packages_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No packages available. Add packages first."
        android:textColor="@color/accent_orange"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btn_save_member"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="@color/primary"
        android:text="Save Member"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_white"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Payment &amp; Revenue"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_month_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Revenue Breakdown by Plan"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- Total Revenue Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_card_orange"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTIMATED MONTHLY REVENUE"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="sans-serif-bold"/>

                <TextView
                    android:id="@+id/tv_total_monthly_revenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/text_white"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tv_active_subscriptions_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Based on active member subscriptions"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Revenue Breakdown by Plan Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVENUE BREAKDOWN BY PLAN"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="12dp"/>

            <!-- Dynamic Plan Breakdown Container -->
            <LinearLayout
                android:id="@+id/container_plan_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <!-- Dynamically populated from Java -->
            </LinearLayout>

            <!-- Member Subscriptions & Payment Status Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMBER SUBSCRIPTION PAYMENTS"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:letterSpacing="0.06"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="12dp"/>

            <!-- Dynamic Member Payments Container -->
            <LinearLayout
                android:id="@+id/container_member_payments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Dynamically populated from Java -->
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>


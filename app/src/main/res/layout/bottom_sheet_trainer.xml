<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle/Drag indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_input_default"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Trainer"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Full Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_trainer_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="Alex Johnson"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Specialization -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Specialization"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_trainer_specialization"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="Strength &amp; Conditioning"
        android:inputType="text"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Email Address -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email Address"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_trainer_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="alex@example.com"
        android:inputType="textEmailAddress"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Phone Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone Number"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_trainer_phone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="+1 234 567 8900"
        android:inputType="phone"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@color/text_gray"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_trainer_password"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_input_default"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/white"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Save Button -->
    <Button
        android:id="@+id/btn_save_trainer"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="@color/primary"
        android:text="Save Trainer"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"/>

</LinearLayout>
